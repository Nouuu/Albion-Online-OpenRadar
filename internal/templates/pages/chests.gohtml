{{define "pages/chests"}}
<div class="space-y-6 stagger">
    <div class="card bg-base-200">
        <div class="card-body">
            <h1 class="text-3xl font-bold text-base-content">Chests & Dungeons</h1>
            <p class="text-base-content/60 mt-2">Configure chest, mist, and dungeon detection settings.</p>
        </div>
    </div>

    <div role="alert" class="alert bg-warning/20 border border-warning/40">
        <i data-lucide="construction" class="w-5 h-5 text-warning"></i>
        <div>
            <h3 class="font-bold text-warning">Experimental features</h3>
            <p class="text-sm">Chests detection is still a work in progress. Some elements may not display correctly or at all.</p>
        </div>
    </div>

    <div class="card bg-base-200">
        <div class="card-body">
            <h2 class="text-xl font-semibold text-base-content mb-4 flex items-center gap-2">
                <i data-lucide="archive" class="w-5 h-5 text-warning"></i>
                Chests
            </h2>
            <p class="text-base-content/60 text-sm mb-4">Select which chest rarities to display on the radar.</p>
            <div class="flex flex-wrap gap-2">
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingChestsGreen" class="checkbox checkbox-primary checkbox-xs">
                    <span class="w-3 h-3 rounded-full bg-tier-2"></span>
                    <span data-setting-label="settingChestsGreen" class="text-base-content/80 text-xs group-hover:text-base-content">Green</span>
                    <div class="tooltip" data-setting-tip="settingChestsGreen" data-tip="Loot chests of this rarity. The rarity is read from the chest name, so some chests are not shown.">
                        <span tabindex="0" role="img" aria-label="Loot chests of this rarity. The rarity is read from the chest name, so some chests are not shown." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                    </div>
                </label>
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingChestsBlue" class="checkbox checkbox-primary checkbox-xs">
                    <span class="w-3 h-3 rounded-full bg-tier-3"></span>
                    <span data-setting-label="settingChestsBlue" class="text-base-content/80 text-xs group-hover:text-base-content">Blue</span>
                    <div class="tooltip" data-setting-tip="settingChestsBlue" data-tip="Loot chests of this rarity. The rarity is read from the chest name, so some chests are not shown.">
                        <span tabindex="0" role="img" aria-label="Loot chests of this rarity. The rarity is read from the chest name, so some chests are not shown." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                    </div>
                </label>
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingChestsPurple" class="checkbox checkbox-primary checkbox-xs">
                    <span class="w-3 h-3 rounded-full bg-tier-4"></span>
                    <span data-setting-label="settingChestsPurple" class="text-base-content/80 text-xs group-hover:text-base-content">Purple</span>
                    <div class="tooltip" data-setting-tip="settingChestsPurple" data-tip="Loot chests of this rarity. The rarity is read from the chest name, so some chests are not shown.">
                        <span tabindex="0" role="img" aria-label="Loot chests of this rarity. The rarity is read from the chest name, so some chests are not shown." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                    </div>
                </label>
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingChestsYellow" class="checkbox checkbox-primary checkbox-xs">
                    <span class="w-3 h-3 rounded-full bg-tier-5"></span>
                    <span data-setting-label="settingChestsYellow" class="text-base-content/80 text-xs group-hover:text-base-content">Yellow</span>
                    <div class="tooltip" data-setting-tip="settingChestsYellow" data-tip="Loot chests of this rarity. The rarity is read from the chest name, so some chests are not shown.">
                        <span tabindex="0" role="img" aria-label="Loot chests of this rarity. The rarity is read from the chest name, so some chests are not shown." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                    </div>
                </label>
            </div>
        </div>
    </div>

    <div class="card bg-base-200">
        <div class="card-body">
            <h2 class="text-xl font-semibold text-base-content mb-4 flex items-center gap-2">
                <i data-lucide="cloud-fog" class="w-5 h-5 text-secondary"></i>
                Mists
            </h2>

            <div class="space-y-4">
                <div>
                    <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                        <i data-lucide="users" class="w-4 h-4 text-base-content/50"></i>
                        Type
                    </h3>
                    <div class="flex flex-wrap gap-2">
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingMistsSolo" class="checkbox checkbox-primary checkbox-xs">
                            <i data-lucide="user" class="w-4 h-4 text-base-content/50"></i>
                            <span data-setting-label="settingMistsSolo" class="text-base-content/80 text-xs group-hover:text-base-content">Solo</span>
                            <div class="tooltip" data-setting-tip="settingMistsSolo" data-tip="Solo mist portals (1 player)">
                                <span tabindex="0" role="img" aria-label="Solo mist portals (1 player)" class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                            </div>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingMistsDuo" class="checkbox checkbox-primary checkbox-xs">
                            <i data-lucide="users" class="w-4 h-4 text-base-content/50"></i>
                            <span data-setting-label="settingMistsDuo" class="text-base-content/80 text-xs group-hover:text-base-content">Duo</span>
                            <div class="tooltip" data-setting-tip="settingMistsDuo" data-tip="Duo mist portals (2 players)">
                                <span tabindex="0" role="img" aria-label="Duo mist portals (2 players)" class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                            </div>
                        </label>
                    </div>
                </div>

                <div>
                    <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                        <i data-lucide="sparkles" class="w-4 h-4 text-base-content/50"></i>
                        Enchant Level
                    </h3>
                    <div class="flex flex-wrap gap-2">
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingMistsEnchant0" class="checkbox checkbox-primary checkbox-xs">
                            <span data-setting-label="settingMistsEnchant0" class="text-base-content/80 text-xs group-hover:text-base-content">E0</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingMistsEnchant1" class="checkbox checkbox-primary checkbox-xs">
                            <span data-setting-label="settingMistsEnchant1" class="text-base-content/80 text-xs group-hover:text-base-content">E1</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingMistsEnchant2" class="checkbox checkbox-primary checkbox-xs">
                            <span data-setting-label="settingMistsEnchant2" class="text-base-content/80 text-xs group-hover:text-base-content">E2</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingMistsEnchant3" class="checkbox checkbox-primary checkbox-xs">
                            <span data-setting-label="settingMistsEnchant3" class="text-base-content/80 text-xs group-hover:text-base-content">E3</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingMistsEnchant4" class="checkbox checkbox-primary checkbox-xs">
                            <span data-setting-label="settingMistsEnchant4" class="text-base-content/80 text-xs group-hover:text-base-content">E4</span>
                        </label>
                    </div>
                </div>

                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingMistsWispCages" class="toggle toggle-primary toggle-sm">
                    <i data-lucide="box" class="w-4 h-4 text-base-content/50"></i>
                    <span data-setting-label="settingMistsWispCages" class="text-base-content/80 text-xs group-hover:text-base-content">Show Wisp Cages</span>
                    <div class="tooltip" data-setting-tip="settingMistsWispCages" data-tip="Display wisp cages locations in mists">
                        <span tabindex="0" role="img" aria-label="Display wisp cages locations in mists" class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                    </div>
                </label>

                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingMistsWisps" class="toggle toggle-primary toggle-sm">
                    <i data-lucide="sparkles" class="w-4 h-4 text-base-content/50"></i>
                    <span data-setting-label="settingMistsWisps" class="text-base-content/80 text-xs group-hover:text-base-content">Wisp signs (pre-portal)</span>
                    <div class="tooltip" data-setting-tip="settingMistsWisps" data-tip="Shows the wisp signs that appear before a Mists portal opens. The Solo/Duo and rarity filters also apply.">
                        <span tabindex="0" role="img" aria-label="Shows the wisp signs that appear before a Mists portal opens. The Solo/Duo and rarity filters also apply." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                    </div>
                </label>

                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingMistsKnightfallAbbey" class="toggle toggle-primary toggle-sm">
                    <i data-lucide="church" class="w-4 h-4 text-base-content/50"></i>
                    <span data-setting-label="settingMistsKnightfallAbbey" class="text-base-content/80 text-xs group-hover:text-base-content">Show Knightfall Abbey</span>
                    <div class="tooltip" data-setting-tip="settingMistsKnightfallAbbey" data-tip="Shows Knightfall Abbey entrances.">
                        <span tabindex="0" role="img" aria-label="Shows Knightfall Abbey entrances." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                    </div>
                </label>
            </div>
        </div>
    </div>

    <div class="card bg-base-200">
        <div class="card-body">
            <h2 class="text-xl font-semibold text-base-content mb-4 flex items-center gap-2">
                <i data-lucide="door-open" class="w-5 h-5 text-primary"></i>
                Dungeons
            </h2>

            <div class="space-y-4">
                <div>
                    <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                        <i data-lucide="users" class="w-4 h-4 text-base-content/50"></i>
                        Type
                    </h3>
                    <div class="flex flex-wrap gap-2">
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingDungeonsSolo" class="checkbox checkbox-primary checkbox-xs">
                            <i data-lucide="user" class="w-4 h-4 text-base-content/50"></i>
                            <span data-setting-label="settingDungeonsSolo" class="text-base-content/80 text-xs group-hover:text-base-content">Solo</span>
                            <div class="tooltip" data-setting-tip="settingDungeonsSolo" data-tip="Solo random dungeons">
                                <span tabindex="0" role="img" aria-label="Solo random dungeons" class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                            </div>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingDungeonsGroup" class="checkbox checkbox-primary checkbox-xs">
                            <i data-lucide="users" class="w-4 h-4 text-base-content/50"></i>
                            <span data-setting-label="settingDungeonsGroup" class="text-base-content/80 text-xs group-hover:text-base-content">Group</span>
                            <div class="tooltip" data-setting-tip="settingDungeonsGroup" data-tip="Group random dungeon entrances, plus any entrance not recognized as solo, corrupted or hellgate. The E0 to E4 filters also apply.">
                                <span tabindex="0" role="img" aria-label="Group random dungeon entrances, plus any entrance not recognized as solo, corrupted or hellgate. The E0 to E4 filters also apply." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                            </div>
                        </label>
                    </div>
                </div>

                <div>
                    <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                        <i data-lucide="sparkles" class="w-4 h-4 text-base-content/50"></i>
                        Enchant Level
                    </h3>
                    <div class="flex flex-wrap gap-2">
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingDungeonsEnchant0" class="checkbox checkbox-primary checkbox-xs">
                            <span data-setting-label="settingDungeonsEnchant0" class="text-base-content/80 text-xs group-hover:text-base-content">E0</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingDungeonsEnchant1" class="checkbox checkbox-primary checkbox-xs">
                            <span data-setting-label="settingDungeonsEnchant1" class="text-base-content/80 text-xs group-hover:text-base-content">E1</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingDungeonsEnchant2" class="checkbox checkbox-primary checkbox-xs">
                            <span data-setting-label="settingDungeonsEnchant2" class="text-base-content/80 text-xs group-hover:text-base-content">E2</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingDungeonsEnchant3" class="checkbox checkbox-primary checkbox-xs">
                            <span data-setting-label="settingDungeonsEnchant3" class="text-base-content/80 text-xs group-hover:text-base-content">E3</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingDungeonsEnchant4" class="checkbox checkbox-primary checkbox-xs">
                            <span data-setting-label="settingDungeonsEnchant4" class="text-base-content/80 text-xs group-hover:text-base-content">E4</span>
                        </label>
                    </div>
                </div>

                <div>
                    <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                        <i data-lucide="flame" class="w-4 h-4 text-base-content/50"></i>
                        Special
                    </h3>
                    <div class="flex flex-wrap gap-2">
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingDungeonsCorrupted" class="checkbox checkbox-primary checkbox-xs">
                            <span class="w-3 h-3 rounded-full bg-error"></span>
                            <span data-setting-label="settingDungeonsCorrupted" class="text-base-content/80 text-xs group-hover:text-base-content">Corrupted</span>
                            <div class="tooltip" data-setting-tip="settingDungeonsCorrupted" data-tip="Corrupted dungeon entrances (PvP)">
                                <span tabindex="0" role="img" aria-label="Corrupted dungeon entrances (PvP)" class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                            </div>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingDungeonsHellgate" class="checkbox checkbox-primary checkbox-xs">
                            <span class="w-3 h-3 rounded-full bg-tier-6"></span>
                            <span data-setting-label="settingDungeonsHellgate" class="text-base-content/80 text-xs group-hover:text-base-content">Hellgate</span>
                            <div class="tooltip" data-setting-tip="settingDungeonsHellgate" data-tip="Hellgate portals (PvP)">
                                <span tabindex="0" role="img" aria-label="Hellgate portals (PvP)" class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                            </div>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{{end}}

{{define "scripts/chests"}}
<script>
    import('/scripts/utils/SettingControls.js').then(({registerBoundPage}) => registerBoundPage('chests'));
</script>
{{end}}
