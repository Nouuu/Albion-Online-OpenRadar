{{define "pages/radar"}}
<style>
/* Player cards grid: max columns based on visible sections */
/* 1 section: max 2 cards per row, but switch to 1 col earlier (min 400px per card) */
[data-sections="1"] .player-cards {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, max(400px, calc((100% - 0.75rem) / 2))), 1fr));
}
/* 2-3 sections: 1 card per row */
[data-sections="2"] .player-cards,
[data-sections="3"] .player-cards {
    grid-template-columns: 1fr;
}
</style>
<div class="space-y-4">
    <!-- Canvas Section -->
    <div class="card bg-base-200">
        <div class="card-body p-2 sm:p-4 phone-landscape:p-2 phone-landscape:flex-row phone-landscape:flex-wrap phone-landscape:items-start">
            <div id="canvasContainer" class="relative mx-auto shrink-0 rounded-lg ring-2 ring-base-content/10" style="width: 500px; height: 500px;">
                <canvas class="ttcan absolute top-0 left-0 rounded-lg" id="mapCanvas" width="500" height="500" style="z-index: 1;"></canvas>
                <canvas class="ttcan absolute top-0 left-0" id="drawCanvas" width="500" height="500" style="z-index: 3;"></canvas>
                <canvas class="ttcan absolute top-0 left-0" id="ourPlayerCanvas" width="500" height="500" style="z-index: 5;"></canvas>
                <canvas class="ttcan absolute top-0 left-0" id="uiCanvas" width="500" height="500" style="z-index: 6;"></canvas>
            </div>
            <div id="radarSettingsPanel" class="collapse collapse-arrow bg-base-300/50 rounded-lg mt-3 phone-landscape:grow phone-landscape:basis-72">
                <input type="checkbox" data-setting="settingUiRadarSettingsOpen" aria-label="Radar settings"/>
                <div class="collapse-title text-sm font-semibold flex items-center gap-2">
                    <i data-lucide="sliders-horizontal" class="w-4 h-4"></i>
                    <span data-setting-label="settingUiRadarSettingsOpen">Radar settings</span>
                </div>
                <div class="collapse-content @container text-sm">
                    <div class="grid grid-cols-1 @2xl:grid-cols-2 @5xl:grid-cols-3 gap-4">
                        <section class="space-y-2">
                            <h3 class="text-xs font-semibold uppercase tracking-wide text-base-content/50">View</h3>
                            <div class="flex flex-wrap items-center gap-2">
                                <span data-setting-label="settingRadarZoom" class="text-base-content/70 w-24">Zoom</span>
                                <button type="button" data-nudge="settingRadarZoom" data-dir="-1" class="btn btn-ghost btn-xs">−</button>
                                <input type="range" data-setting="settingRadarZoom" min="0.1" max="3" step="0.1" aria-label="Zoom" class="range range-primary range-xs w-24">
                                <button type="button" data-nudge="settingRadarZoom" data-dir="1" class="btn btn-ghost btn-xs">+</button>
                                <span data-value-for="settingRadarZoom" class="text-xs text-base-content/60 font-mono w-12"></span>
                                <button type="button" data-reset="settingRadarZoom" class="btn btn-ghost btn-xs">Reset</button>
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                <span data-setting-label="settingRadarSize" class="text-base-content/70 w-24">Max size</span>
                                <span class="tooltip" data-setting-tip="settingRadarSize" data-tip="Width and height of the radar in pixels, reduced when the window is too small. Ignored while Fit to screen is on.">
                                    <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                                </span>
                                <button type="button" data-nudge="settingRadarSize" data-dir="-1" class="btn btn-ghost btn-xs">−</button>
                                <input type="range" data-setting="settingRadarSize" min="300" max="800" step="50" aria-label="Max size" class="range range-primary range-xs w-24">
                                <button type="button" data-nudge="settingRadarSize" data-dir="1" class="btn btn-ghost btn-xs">+</button>
                                <span data-value-for="settingRadarSize" class="text-xs text-base-content/60 font-mono w-14"></span>
                                <button type="button" data-reset="settingRadarSize" class="btn btn-ghost btn-xs">Reset</button>
                            </div>
                            <label class="flex flex-wrap items-center gap-2 cursor-pointer">
                                <input type="checkbox" data-setting="settingRadarFitToScreen" class="checkbox checkbox-primary checkbox-xs">
                                <span data-setting-label="settingRadarFitToScreen" class="text-base-content/70">Fit to screen</span>
                                <span class="tooltip" data-setting-tip="settingRadarFitToScreen" data-tip="Makes the radar the largest square that fits the window, up to 1200 px. Max size is ignored while this is on.">
                                    <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                                </span>
                            </label>
                            <div class="flex flex-wrap items-center gap-2">
                                <span data-setting-label="settingRadarIconSize" class="text-base-content/70 w-24">Icon size</span>
                                <button type="button" data-nudge="settingRadarIconSize" data-dir="-1" class="btn btn-ghost btn-xs">−</button>
                                <input type="range" data-setting="settingRadarIconSize" min="0.5" max="2" step="0.1" aria-label="Icon size" class="range range-primary range-xs w-24">
                                <button type="button" data-nudge="settingRadarIconSize" data-dir="1" class="btn btn-ghost btn-xs">+</button>
                                <span data-value-for="settingRadarIconSize" class="text-xs text-base-content/60 font-mono w-12"></span>
                                <button type="button" data-reset="settingRadarIconSize" class="btn btn-ghost btn-xs">Reset</button>
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                <span data-setting-label="settingRadarRotation" class="text-base-content/70 w-24">Rotation</span>
                                <span class="tooltip" data-setting-tip="settingRadarRotation" data-tip="Turns the radar clockwise by quarter turns, for a screen held sideways. The zone and stats boxes and Picture-in-Picture turn with it. The page and this panel stay upright.">
                                    <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                                </span>
                                <div data-setting="settingRadarRotation" role="radiogroup" aria-label="Rotation" class="flex flex-wrap items-center gap-3">
                                    <label class="flex items-center gap-1 cursor-pointer"><input type="radio" name="radarRotation" value="0" class="radio radio-primary radio-xs">0°</label>
                                    <label class="flex items-center gap-1 cursor-pointer"><input type="radio" name="radarRotation" value="90" class="radio radio-primary radio-xs">90°</label>
                                    <label class="flex items-center gap-1 cursor-pointer"><input type="radio" name="radarRotation" value="180" class="radio radio-primary radio-xs">180°</label>
                                    <label class="flex items-center gap-1 cursor-pointer"><input type="radio" name="radarRotation" value="270" class="radio radio-primary radio-xs">270°</label>
                                </div>
                            </div>
                        </section>
                        <section class="space-y-2">
                            <h3 class="text-xs font-semibold uppercase tracking-wide text-base-content/50">Display</h3>
                            <label class="flex flex-wrap items-center gap-2 cursor-pointer">
                                <input type="checkbox" data-setting="settingRadarMapBackground" class="checkbox checkbox-primary checkbox-xs">
                                <span data-setting-label="settingRadarMapBackground" class="text-base-content/70">Map background</span>
                            </label>
                            <label class="flex flex-wrap items-center gap-2 cursor-pointer">
                                <input type="checkbox" data-setting="settingRadarHudZoneInfo" class="checkbox checkbox-primary checkbox-xs">
                                <span data-setting-label="settingRadarHudZoneInfo" class="text-base-content/70">Zone info box</span>
                                <span class="tooltip" data-setting-tip="settingRadarHudZoneInfo" data-tip="Top-left box with the zone name, tier and a PvP marker.">
                                    <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                                </span>
                            </label>
                            <label class="flex flex-wrap items-center gap-2 cursor-pointer">
                                <input type="checkbox" data-setting="settingRadarHudStats" class="checkbox checkbox-primary checkbox-xs">
                                <span data-setting-label="settingRadarHudStats" class="text-base-content/70">Stats box</span>
                                <span class="tooltip" data-setting-tip="settingRadarHudStats" data-tip="Top-right box counting the resource nodes and mobs drawn, and the detected players when player detection is on.">
                                    <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                                </span>
                            </label>
                        </section>
                        <section class="space-y-2">
                            <h3 class="text-xs font-semibold uppercase tracking-wide text-base-content/50">Resources</h3>
                            <label class="flex flex-wrap items-center gap-2 cursor-pointer">
                                <input type="checkbox" data-setting="settingRadarResourceCount" class="checkbox checkbox-primary checkbox-xs">
                                <span data-setting-label="settingRadarResourceCount" class="text-base-content/70">Resource count</span>
                                <span class="tooltip" data-setting-tip="settingRadarResourceCount" data-tip="Estimated quantity next to each resource node, from its size and tier, gathering bonuses not included. Fishing spots show spawned/total fish.">
                                    <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                                </span>
                            </label>
                            <label class="flex flex-wrap items-center gap-2 cursor-pointer">
                                <input type="checkbox" data-setting="settingRadarResourceDistance" class="checkbox checkbox-primary checkbox-xs">
                                <span data-setting-label="settingRadarResourceDistance" class="text-base-content/70">Resource distance</span>
                                <span class="tooltip" data-setting-tip="settingRadarResourceDistance" data-tip="Distance in meters beside each resource: hidden within 2 m, green under 10 m, yellow 10 to 19 m, orange from 20 m.">
                                    <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                                </span>
                            </label>
                            <label class="flex flex-wrap items-center gap-2 cursor-pointer">
                                <input type="checkbox" data-setting="settingRadarResourceTierBadges" class="checkbox checkbox-primary checkbox-xs">
                                <span data-setting-label="settingRadarResourceTierBadges" class="text-base-content/70">Resource tier color badges</span>
                                <span class="tooltip" data-setting-tip="settingRadarResourceTierBadges" data-tip="Replaces resource icons with squares colored by resource type, showing tier and enchantment. Living creatures get a gold border.">
                                    <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                                </span>
                            </label>
                            <label class="flex flex-wrap items-center gap-2 cursor-pointer">
                                <input type="checkbox" data-setting="settingRadarResourceClusters" class="checkbox checkbox-primary checkbox-xs">
                                <span data-setting-label="settingRadarResourceClusters" class="text-base-content/70">Resource clusters</span>
                                <span class="tooltip" data-setting-tip="settingRadarResourceClusters" data-tip="Rings groups of nearby resource nodes of the same type and tier, with the node count, total quantity and distance. Only nodes your resource filters show are grouped.">
                                    <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                                </span>
                            </label>
                            <div class="flex flex-wrap items-center gap-2 pl-6">
                                <span data-setting-label="settingRadarClusterRadius" class="text-base-content/70">Cluster radius (m)</span>
                                <span class="tooltip" data-setting-tip="settingRadarClusterRadius" data-tip="Resources of the same type and tier within this distance of a node are grouped. Default: 30 m.">
                                    <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                                </span>
                                <input type="number" data-setting="settingRadarClusterRadius" min="10" max="100" step="5" aria-label="Cluster radius (m)" class="input input-bordered input-xs w-20">
                            </div>
                            <div class="flex flex-wrap items-center gap-2 pl-6">
                                <span data-setting-label="settingRadarClusterMinSize" class="text-base-content/70">Min nodes per cluster</span>
                                <span class="tooltip" data-setting-tip="settingRadarClusterMinSize" data-tip="Smallest group drawn as a cluster. Default: 2.">
                                    <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                                </span>
                                <input type="number" data-setting="settingRadarClusterMinSize" min="2" max="10" step="1" aria-label="Min nodes per cluster" class="input input-bordered input-xs w-16">
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Detected Players Section -->
    <div id="playersSection" class="card bg-base-200">
        <div class="card-body">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <h3 class="text-xl font-semibold text-base-content flex items-center gap-3">
                    Detected Players
                    <label class="flex items-center gap-1.5 cursor-pointer">
                        <input type="checkbox" id="settingPlayersDetect" data-setting="settingPlayersDetect" class="checkbox checkbox-primary checkbox-xs">
                        <span data-setting-label="settingPlayersDetect" class="text-xs text-base-content/60 font-normal">Detect players</span>
                        <div class="tooltip font-normal" data-setting-tip="settingPlayersDetect" data-tip="Tracks players in range. Off: no player list, no player counts, no flash, border or sound.">
                            <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                        </div>
                    </label>
                </h3>
                <!-- Compact Player Stats (next to title) -->
                <div id="playerStats" class="hidden stats stats-horizontal bg-base-300/50 shadow-sm text-xs">
                    <div id="statHostileContainer" class="stat py-1 px-3 gap-0">
                        <div class="stat-title text-[10px]">Hostile</div>
                        <div id="statHostile" class="stat-value text-error text-sm">0</div>
                    </div>
                    <div id="statFactionContainer" class="stat py-1 px-3 gap-0">
                        <div class="stat-title text-[10px]">Faction</div>
                        <div id="statFaction" class="stat-value text-info text-sm">0</div>
                    </div>
                    <div id="statPassiveContainer" class="stat py-1 px-3 gap-0">
                        <div class="stat-title text-[10px]">Passive</div>
                        <div id="statPassive" class="stat-value text-success text-sm">0</div>
                    </div>
                </div>
            </div>
            <div id="playersListContainer" class="mt-4">
                <!-- Flex container: sections share space equally, wrap on small screens -->
                <!-- data-sections set by JS: controls card grid columns -->
                <div id="playersList" class="flex flex-col sm:flex-row sm:flex-wrap gap-4" data-sections="0">
                    <!-- Hostile Section -->
                    <div id="playersHostile" class="hidden flex-1 min-w-0 sm:min-w-[280px]">
                        <div class="flex items-center gap-2 pb-2 mb-3 border-b border-error/20">
                            <span class="text-sm font-medium text-error">Hostiles</span>
                            <span id="hostileCount" class="text-xs text-base-content/50">(0)</span>
                        </div>
                        <div id="hostileList" class="player-cards grid gap-3 max-h-[400px] overflow-y-auto pr-1 scrollbar-thin"></div>
                    </div>

                    <!-- Faction Section -->
                    <div id="playersFaction" class="hidden flex-1 min-w-0 sm:min-w-[280px]">
                        <div class="flex items-center gap-2 pb-2 mb-3 border-b border-info/20">
                            <span class="text-sm font-medium text-info">Faction</span>
                            <span id="factionCount" class="text-xs text-base-content/50">(0)</span>
                        </div>
                        <div id="factionList" class="player-cards grid gap-3 max-h-[400px] overflow-y-auto pr-1 scrollbar-thin"></div>
                    </div>

                    <!-- Passive Section -->
                    <div id="playersPassive" class="hidden flex-1 min-w-0 sm:min-w-[280px]">
                        <div class="flex items-center gap-2 pb-2 mb-3 border-b border-success/20">
                            <span class="text-sm font-medium text-success">Passive</span>
                            <span id="passiveCount" class="text-xs text-base-content/50">(0)</span>
                        </div>
                        <div id="passiveList" class="player-cards grid gap-3 max-h-[400px] overflow-y-auto pr-1 scrollbar-thin"></div>
                    </div>

                    <!-- Empty State -->
                    <div id="playersEmpty" class="w-full flex flex-col items-center justify-center py-8 text-center">
                        <span class="loading loading-ring loading-lg text-primary mb-3"></span>
                        <p class="text-sm text-base-content/40">No players detected yet</p>
                        <p class="text-xs text-base-content/25 font-mono mt-1">Scanning...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{{end}}

{{define "scripts/radar"}}
<script>
    Promise.all([
        import('/scripts/utils/SettingControls.js'),
        import('/scripts/utils/Utils.js'),
    ]).then(([{registerBoundPage}, {initRadarPage, destroyRadarPage}]) =>
        registerBoundPage('radar', {init: initRadarPage, destroy: destroyRadarPage}));
</script>
{{end}}
