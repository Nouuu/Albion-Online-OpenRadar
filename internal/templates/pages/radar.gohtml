{{define "pages/radar"}}
<style>
/* Player cards grid: max columns based on visible sections */
/* 1 section: max 2 cards per row, but switch to 1 col earlier (min 400px per card) */
[data-sections="1"] .player-cards {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, max(400px, calc((100% - 0.75rem) / 2))), 1fr));
}
/* 2-3 sections: 1 card per row */
[data-sections="2"] .player-cards,
[data-sections="3"] .player-cards {
    grid-template-columns: 1fr;
}
</style>
<div class="space-y-4">
    <!-- Canvas Section -->
    <div class="card bg-base-200">
        <div class="card-body p-2 sm:p-4 phone-landscape:p-2 phone-landscape:flex-row phone-landscape:flex-wrap phone-landscape:items-start">
            <div id="canvasContainer" class="relative mx-auto shrink-0 max-w-full rounded-lg ring-2 ring-base-content/10" style="width: 500px; height: 500px;">
                <canvas class="ttcan absolute top-0 left-0 max-w-full rounded-lg" id="mapCanvas" width="500" height="500" style="z-index: 1;"></canvas>
                <canvas class="ttcan absolute top-0 left-0 max-w-full" id="drawCanvas" width="500" height="500" style="z-index: 3;"></canvas>
                <canvas class="ttcan absolute top-0 left-0 max-w-full" id="ourPlayerCanvas" width="500" height="500" style="z-index: 5;"></canvas>
                <canvas class="ttcan absolute top-0 left-0 max-w-full" id="uiCanvas" width="500" height="500" style="z-index: 6;"></canvas>
            </div>
            <div id="radarSettingsPanel" class="collapse collapse-arrow bg-base-300/50 rounded-lg mt-3 phone-landscape:grow phone-landscape:basis-72">
                <input type="checkbox" data-setting="settingUiRadarSettingsOpen" aria-label="Radar settings"/>
                <div class="collapse-title text-sm font-semibold flex items-center gap-2">
                    <i data-lucide="sliders-horizontal" class="w-4 h-4"></i>
                    <span id="label-settingUiRadarSettingsOpen" data-setting-label="settingUiRadarSettingsOpen">Radar settings</span>
                </div>
                <div class="collapse-content @container text-sm text-base-content/80">
                    <div class="grid grid-cols-1 @2xl:grid-cols-2 gap-x-8 gap-y-6 pt-1">
                        <section>
                            <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                                <i data-lucide="monitor" class="w-4 h-4"></i>
                                View
                            </h3>
                            <div class="grid grid-cols-[repeat(auto-fill,minmax(min(16rem,100%),1fr))] gap-2">
                                <div class="col-span-full flex items-center gap-2 p-2 rounded-lg bg-base-300">
                                    <i data-lucide="zoom-in" class="w-4 h-4 shrink-0 text-base-content/50"></i>
                                    <span id="label-settingRadarZoom" data-setting-label="settingRadarZoom" class="text-base-content/80 text-xs whitespace-nowrap">Zoom</span>
                                    <button type="button" data-nudge="settingRadarZoom" data-dir="-1" aria-label="Decrease zoom" title="Decrease zoom" class="btn btn-ghost btn-xs btn-square ml-auto"><i data-lucide="minus" class="w-3 h-3"></i></button>
                                    <input type="range" data-setting="settingRadarZoom" aria-labelledby="label-settingRadarZoom" min="0.1" max="3" step="0.1" class="range range-primary range-xs min-w-0 w-full max-w-64">
                                    <button type="button" data-nudge="settingRadarZoom" data-dir="1" aria-label="Increase zoom" title="Increase zoom" class="btn btn-ghost btn-xs btn-square"><i data-lucide="plus" class="w-3 h-3"></i></button>
                                    <span data-value-for="settingRadarZoom" class="text-xs text-base-content/60 font-mono tabular-nums w-14 text-right whitespace-nowrap"></span>
                                    <button type="button" data-reset="settingRadarZoom" aria-label="Reset zoom" title="Reset zoom" class="btn btn-ghost btn-xs btn-square"><i data-lucide="rotate-ccw" class="w-3 h-3"></i></button>
                                </div>
                                <div class="col-span-full flex items-center gap-2 p-2 rounded-lg bg-base-300">
                                    <i data-lucide="maximize" class="w-4 h-4 shrink-0 text-base-content/50"></i>
                                    <span id="label-settingRadarSize" data-setting-label="settingRadarSize" class="text-base-content/80 text-xs whitespace-nowrap">Max size</span>
                                    <div class="tooltip" data-setting-tip="settingRadarSize" data-tip="Width and height of the radar in pixels, reduced when the window is too small. Ignored while Fit to screen is on.">
                                        <span tabindex="0" role="img" aria-label="Width and height of the radar in pixels, reduced when the window is too small. Ignored while Fit to screen is on." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                                    </div>
                                    <button type="button" data-nudge="settingRadarSize" data-dir="-1" aria-label="Decrease max size" title="Decrease max size" class="btn btn-ghost btn-xs btn-square ml-auto"><i data-lucide="minus" class="w-3 h-3"></i></button>
                                    <input type="range" data-setting="settingRadarSize" aria-labelledby="label-settingRadarSize" min="300" max="1200" step="50" class="range range-primary range-xs min-w-0 w-full max-w-64">
                                    <button type="button" data-nudge="settingRadarSize" data-dir="1" aria-label="Increase max size" title="Increase max size" class="btn btn-ghost btn-xs btn-square"><i data-lucide="plus" class="w-3 h-3"></i></button>
                                    <span data-value-for="settingRadarSize" class="text-xs text-base-content/60 font-mono tabular-nums w-14 text-right whitespace-nowrap"></span>
                                    <button type="button" data-reset="settingRadarSize" aria-label="Reset max size" title="Reset max size" class="btn btn-ghost btn-xs btn-square"><i data-lucide="rotate-ccw" class="w-3 h-3"></i></button>
                                </div>
                                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                                    <input type="checkbox" data-setting="settingRadarFitToScreen" aria-labelledby="label-settingRadarFitToScreen" class="toggle toggle-primary toggle-sm">
                                    <span id="label-settingRadarFitToScreen" data-setting-label="settingRadarFitToScreen" class="text-base-content/80 text-xs group-hover:text-base-content">Fit to screen</span>
                                    <div class="tooltip" data-setting-tip="settingRadarFitToScreen" data-tip="Makes the radar the largest square that fits the window, up to 1200 px. Max size is ignored while this is on.">
                                        <span tabindex="0" role="img" aria-label="Makes the radar the largest square that fits the window, up to 1200 px. Max size is ignored while this is on." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                                    </div>
                                </label>
                                <div class="col-span-full flex items-center gap-2 p-2 rounded-lg bg-base-300">
                                    <i data-lucide="image" class="w-4 h-4 shrink-0 text-base-content/50"></i>
                                    <span id="label-settingRadarIconSize" data-setting-label="settingRadarIconSize" class="text-base-content/80 text-xs whitespace-nowrap">Icon size</span>
                                    <button type="button" data-nudge="settingRadarIconSize" data-dir="-1" aria-label="Decrease icon size" title="Decrease icon size" class="btn btn-ghost btn-xs btn-square ml-auto"><i data-lucide="minus" class="w-3 h-3"></i></button>
                                    <input type="range" data-setting="settingRadarIconSize" aria-labelledby="label-settingRadarIconSize" min="0.5" max="2" step="0.1" class="range range-primary range-xs min-w-0 w-full max-w-64">
                                    <button type="button" data-nudge="settingRadarIconSize" data-dir="1" aria-label="Increase icon size" title="Increase icon size" class="btn btn-ghost btn-xs btn-square"><i data-lucide="plus" class="w-3 h-3"></i></button>
                                    <span data-value-for="settingRadarIconSize" class="text-xs text-base-content/60 font-mono tabular-nums w-14 text-right whitespace-nowrap"></span>
                                    <button type="button" data-reset="settingRadarIconSize" aria-label="Reset icon size" title="Reset icon size" class="btn btn-ghost btn-xs btn-square"><i data-lucide="rotate-ccw" class="w-3 h-3"></i></button>
                                </div>
                            </div>
                        </section>
                        <div class="space-y-6 @2xl:border-l @2xl:border-base-content/5 @2xl:pl-8">
                            <section>
                                <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                                    <i data-lucide="eye" class="w-4 h-4"></i>
                                    Display
                                </h3>
                                <div class="grid grid-cols-[repeat(auto-fill,minmax(min(16rem,100%),1fr))] gap-2">
                                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                                        <input type="checkbox" data-setting="settingRadarMapBackground" class="toggle toggle-primary toggle-sm">
                                        <span id="label-settingRadarMapBackground" data-setting-label="settingRadarMapBackground" class="text-base-content/80 text-xs group-hover:text-base-content">Map background</span>
                                    </label>
                                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                                        <input type="checkbox" data-setting="settingRadarHudZoneInfo" aria-labelledby="label-settingRadarHudZoneInfo" class="toggle toggle-primary toggle-sm">
                                        <span id="label-settingRadarHudZoneInfo" data-setting-label="settingRadarHudZoneInfo" class="text-base-content/80 text-xs group-hover:text-base-content">Zone info box</span>
                                        <div class="tooltip" data-setting-tip="settingRadarHudZoneInfo" data-tip="Top-left box with the zone name, tier and a PvP marker.">
                                            <span tabindex="0" role="img" aria-label="Top-left box with the zone name, tier and a PvP marker." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                                        </div>
                                    </label>
                                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                                        <input type="checkbox" data-setting="settingRadarHudStats" aria-labelledby="label-settingRadarHudStats" class="toggle toggle-primary toggle-sm">
                                        <span id="label-settingRadarHudStats" data-setting-label="settingRadarHudStats" class="text-base-content/80 text-xs group-hover:text-base-content">Stats box</span>
                                        <div class="tooltip" data-setting-tip="settingRadarHudStats" data-tip="Top-right box counting the resource nodes and mobs drawn, and the detected players when player detection is on.">
                                            <span tabindex="0" role="img" aria-label="Top-right box counting the resource nodes and mobs drawn, and the detected players when player detection is on." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                                        </div>
                                    </label>
                                </div>
                            </section>
                            <section>
                                <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                                    <i data-lucide="gem" class="w-4 h-4"></i>
                                    Resources
                                </h3>
                                <div class="grid grid-cols-[repeat(auto-fill,minmax(min(16rem,100%),1fr))] gap-2">
                                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                                        <input type="checkbox" data-setting="settingRadarResourceCount" aria-labelledby="label-settingRadarResourceCount" class="toggle toggle-primary toggle-sm">
                                        <span id="label-settingRadarResourceCount" data-setting-label="settingRadarResourceCount" class="text-base-content/80 text-xs group-hover:text-base-content">Resource count</span>
                                        <div class="tooltip" data-setting-tip="settingRadarResourceCount" data-tip="Estimated quantity next to each resource node, from its size and tier, gathering bonuses not included. Fishing spots show spawned/total fish.">
                                            <span tabindex="0" role="img" aria-label="Estimated quantity next to each resource node, from its size and tier, gathering bonuses not included. Fishing spots show spawned/total fish." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                                        </div>
                                    </label>
                                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                                        <input type="checkbox" data-setting="settingRadarResourceDistance" aria-labelledby="label-settingRadarResourceDistance" class="toggle toggle-primary toggle-sm">
                                        <span id="label-settingRadarResourceDistance" data-setting-label="settingRadarResourceDistance" class="text-base-content/80 text-xs group-hover:text-base-content">Resource distance</span>
                                        <div class="tooltip" data-setting-tip="settingRadarResourceDistance" data-tip="Distance in meters beside each resource: hidden within 2 m, green under 10 m, yellow 10 to 19 m, orange from 20 m.">
                                            <span tabindex="0" role="img" aria-label="Distance in meters beside each resource: hidden within 2 m, green under 10 m, yellow 10 to 19 m, orange from 20 m." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                                        </div>
                                    </label>
                                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                                        <input type="checkbox" data-setting="settingRadarResourceTierBadges" aria-labelledby="label-settingRadarResourceTierBadges" class="toggle toggle-primary toggle-sm">
                                        <span id="label-settingRadarResourceTierBadges" data-setting-label="settingRadarResourceTierBadges" class="text-base-content/80 text-xs group-hover:text-base-content">Resource tier color badges</span>
                                        <div class="tooltip" data-setting-tip="settingRadarResourceTierBadges" data-tip="Replaces resource icons with squares colored by resource type, showing tier and enchantment. Living creatures get a gold border.">
                                            <span tabindex="0" role="img" aria-label="Replaces resource icons with squares colored by resource type, showing tier and enchantment. Living creatures get a gold border." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                                        </div>
                                    </label>
                                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                                        <input type="checkbox" data-setting="settingRadarResourceClusters" aria-labelledby="label-settingRadarResourceClusters" class="toggle toggle-primary toggle-sm">
                                        <span id="label-settingRadarResourceClusters" data-setting-label="settingRadarResourceClusters" class="text-base-content/80 text-xs group-hover:text-base-content">Resource clusters</span>
                                        <div class="tooltip" data-setting-tip="settingRadarResourceClusters" data-tip="Rings groups of nearby resource nodes of the same type and tier, with the node count, total quantity and distance. Only nodes your resource filters show are grouped.">
                                            <span tabindex="0" role="img" aria-label="Rings groups of nearby resource nodes of the same type and tier, with the node count, total quantity and distance. Only nodes your resource filters show are grouped." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                                        </div>
                                    </label>
                                    <div class="col-span-full ml-8 space-y-2">
                                        <label class="flex flex-wrap items-center gap-3">
                                            <input type="number" data-setting="settingRadarClusterRadius" data-enabled-by="settingRadarResourceClusters"
                                                   min="10" max="100" step="5" aria-label="Cluster radius (m)" class="input input-bordered input-sm w-32 disabled:opacity-50">
                                            <span id="label-settingRadarClusterRadius" data-setting-label="settingRadarClusterRadius" class="text-base-content/60 text-sm">Cluster radius (m)</span>
                                            <div class="tooltip" data-setting-tip="settingRadarClusterRadius" data-tip="Resources of the same type and tier within this distance of a node are grouped. Default: 30 m.">
                                                <span tabindex="0" role="img" aria-label="Resources of the same type and tier within this distance of a node are grouped. Default: 30 m." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                                            </div>
                                        </label>
                                        <label class="flex flex-wrap items-center gap-3">
                                            <input type="number" data-setting="settingRadarClusterMinSize" data-enabled-by="settingRadarResourceClusters"
                                                   min="2" max="10" step="1" aria-label="Min nodes per cluster" class="input input-bordered input-sm w-32 disabled:opacity-50">
                                            <span id="label-settingRadarClusterMinSize" data-setting-label="settingRadarClusterMinSize" class="text-base-content/60 text-sm">Min nodes per cluster</span>
                                            <div class="tooltip" data-setting-tip="settingRadarClusterMinSize" data-tip="Smallest group drawn as a cluster. Default: 2.">
                                                <span tabindex="0" role="img" aria-label="Smallest group drawn as a cluster. Default: 2." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                                            </div>
                                        </label>
                                    </div>
                                </div>
                            </section>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Detected Players Section -->
    <div id="playersSection" class="card bg-base-200">
        <div class="card-body">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <h3 class="text-xl font-semibold text-base-content flex flex-wrap items-center gap-3">
                    Detected Players
                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                        <input type="checkbox" id="settingPlayersDetect" data-setting="settingPlayersDetect" aria-labelledby="label-settingPlayersDetect" class="toggle toggle-primary toggle-sm">
                        <span id="label-settingPlayersDetect" data-setting-label="settingPlayersDetect" class="text-base-content/80 text-xs group-hover:text-base-content">Detect players</span>
                        <div class="tooltip" data-setting-tip="settingPlayersDetect" data-tip="Tracks players in range. Off: no player list, no player counts, no flash, border or sound.">
                            <span tabindex="0" role="img" aria-label="Tracks players in range. Off: no player list, no player counts, no flash, border or sound." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                        </div>
                    </label>
                </h3>
                <!-- Compact Player Stats (next to title) -->
                <div id="playerStats" class="hidden stats stats-horizontal bg-base-300/50 shadow-sm text-xs">
                    <div id="statHostileContainer" class="stat py-1 px-3 gap-0">
                        <div class="stat-title text-[10px]">Hostile</div>
                        <div id="statHostile" class="stat-value text-error text-sm">0</div>
                    </div>
                    <div id="statFactionContainer" class="stat py-1 px-3 gap-0">
                        <div class="stat-title text-[10px]">Faction</div>
                        <div id="statFaction" class="stat-value text-info text-sm">0</div>
                    </div>
                    <div id="statPassiveContainer" class="stat py-1 px-3 gap-0">
                        <div class="stat-title text-[10px]">Passive</div>
                        <div id="statPassive" class="stat-value text-success text-sm">0</div>
                    </div>
                </div>
            </div>
            <div id="playersListContainer" class="mt-4">
                <!-- Flex container: sections share space equally, wrap on small screens -->
                <!-- data-sections set by JS: controls card grid columns -->
                <div id="playersList" class="flex flex-col sm:flex-row sm:flex-wrap gap-4" data-sections="0">
                    <!-- Hostile Section -->
                    <div id="playersHostile" class="hidden flex-1 min-w-0 sm:min-w-[280px]">
                        <div class="flex items-center gap-2 pb-2 mb-3 border-b border-error/20">
                            <span class="text-sm font-medium text-error">Hostiles</span>
                            <span id="hostileCount" class="text-xs text-base-content/50">(0)</span>
                        </div>
                        <div id="hostileList" class="player-cards grid gap-3 max-h-[400px] overflow-y-auto pr-1 scrollbar-thin"></div>
                    </div>

                    <!-- Faction Section -->
                    <div id="playersFaction" class="hidden flex-1 min-w-0 sm:min-w-[280px]">
                        <div class="flex items-center gap-2 pb-2 mb-3 border-b border-info/20">
                            <span class="text-sm font-medium text-info">Faction</span>
                            <span id="factionCount" class="text-xs text-base-content/50">(0)</span>
                        </div>
                        <div id="factionList" class="player-cards grid gap-3 max-h-[400px] overflow-y-auto pr-1 scrollbar-thin"></div>
                    </div>

                    <!-- Passive Section -->
                    <div id="playersPassive" class="hidden flex-1 min-w-0 sm:min-w-[280px]">
                        <div class="flex items-center gap-2 pb-2 mb-3 border-b border-success/20">
                            <span class="text-sm font-medium text-success">Passive</span>
                            <span id="passiveCount" class="text-xs text-base-content/50">(0)</span>
                        </div>
                        <div id="passiveList" class="player-cards grid gap-3 max-h-[400px] overflow-y-auto pr-1 scrollbar-thin"></div>
                    </div>

                    <!-- Empty State -->
                    <div id="playersEmpty" class="w-full flex flex-col items-center justify-center py-8 text-center">
                        <span class="loading loading-ring loading-lg text-primary mb-3"></span>
                        <p class="text-sm text-base-content/40">No players detected yet</p>
                        <p class="text-xs text-base-content/25 font-mono mt-1">Scanning...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{{end}}

{{define "scripts/radar"}}
<script>
    Promise.all([
        import('/scripts/utils/SettingControls.js'),
        import('/scripts/utils/Utils.js'),
    ]).then(([{registerBoundPage}, {initRadarPage, destroyRadarPage}]) =>
        registerBoundPage('radar', {init: initRadarPage, destroy: destroyRadarPage}));
</script>
{{end}}
