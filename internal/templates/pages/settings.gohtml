{{define "pages/settings"}}
<!-- Confirmation Modals -->
<dialog id="modal-resetSettings" class="modal">
    <div class="modal-box bg-base-200">
        <div class="flex items-center gap-3 mb-4">
            <div class="p-2 rounded-lg bg-error/10">
                <i data-lucide="alert-triangle" class="w-6 h-6 text-error"></i>
            </div>
            <h3 class="text-lg font-semibold text-base-content">Reset All Settings</h3>
        </div>
        <p class="text-base-content/60 mb-6">Resets every radar setting and layout preference in this browser to its default, then reloads. Your ignore list is kept. Capture interfaces, backend logs and pcap recording are saved on the radar PC and are not changed.</p>
        <div class="modal-action">
            <form method="dialog">
                <button class="btn btn-ghost">Cancel</button>
            </form>
            <button id="confirmResetSettings" class="btn btn-error">Reset Settings</button>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop">
        <button>close</button>
    </form>
</dialog>

<div class="space-y-6 stagger" data-is-host="{{.IsHost}}">
    <div class="card bg-base-200">
        <div class="card-body">
            <h1 class="text-3xl font-bold text-base-content">Settings</h1>
            <p class="text-base-content/60 mt-2">Logging, debug, network and reset options.</p>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiSettingsLoggingOpen"/>
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="scroll-text" class="w-5 h-5 text-info"></i>
            <span data-setting-label="settingUiSettingsLoggingOpen">Logging</span>
        </div>
        <div class="collapse-content">
            <p class="text-xs text-base-content/60 mt-1 pb-2">Logs land in <code>logs/sessions/</code>, <code>logs/debug/</code>, <code>logs/errors/</code>. Backend errors are always saved to <code>logs/errors/</code>. Browser errors are saved only while this browser sends its logs (Settings &gt; Logging &gt; "Save browser logs").</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
                <div>
                    <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                        <i data-lucide="sliders-horizontal" class="w-4 h-4"></i>
                        <span data-setting-label="settingLogLevel">Log Level</span>
                        <div class="tooltip" data-setting-tip="settingLogLevel" data-tip="Lowest level sent to the console and to the server. DEBUG and INFO entries also need their category. OFF drops everything.">
                            <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                        </div>
                    </h3>
                    <select data-setting="settingLogLevel" class="select select-bordered select-sm w-full max-w-xs">
                        <option value="OFF">OFF - No logs</option>
                        <option value="ERROR">ERROR - Errors only</option>
                        <option value="WARN">WARN - Warnings & Errors</option>
                        <option value="INFO">INFO - Info, Warnings & Errors</option>
                        <option value="DEBUG">DEBUG - Everything</option>
                    </select>
                </div>

                <div>
                    <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                        <i data-lucide="monitor" class="w-4 h-4"></i>
                        Output
                    </h3>
                    <div class="space-y-2">
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingLogToConsole" class="toggle toggle-primary toggle-sm">
                            <i data-lucide="terminal" class="w-4 h-4 text-base-content/50"></i>
                            <span data-setting-label="settingLogToConsole" class="text-base-content/80 text-xs group-hover:text-base-content">Browser Console (F12)</span>
                            <div class="tooltip" data-setting-tip="settingLogToConsole" data-tip="Print logs in the browser DevTools console.">
                                <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                            </div>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingLogToServer" class="toggle toggle-primary toggle-sm">
                            <i data-lucide="server" class="w-4 h-4 text-base-content/50"></i>
                            <span data-setting-label="settingLogToServer" class="text-base-content/80 text-xs group-hover:text-base-content">Save browser logs</span>
                            <div class="tooltip" data-setting-tip="settingLogToServer" data-tip="Sends browser log entries that pass the level and category filters to the radar PC, in logs/debug/. ERROR and CRITICAL entries are also copied to logs/errors/.">
                                <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                    <i data-lucide="filter" class="w-4 h-4"></i>
                    Category Filters
                    <span class="text-xs text-base-content/50 font-normal">(applies to DEBUG & INFO only)</span>
                </h3>
                <div class="grid grid-cols-1 min-[21rem]:grid-cols-2 md:grid-cols-3 gap-2">
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingLogCategorySystem" class="checkbox checkbox-primary checkbox-xs">
                            <span data-setting-label="settingLogCategorySystem" class="text-base-content/80 text-xs group-hover:text-base-content">System</span>
                            <div class="tooltip" data-setting-tip="settingLogCategorySystem" data-tip="Keep DEBUG and INFO entries of this area. WARN and above ignore this filter.">
                                <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                            </div>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingLogCategoryNetwork" class="checkbox checkbox-primary checkbox-xs">
                            <span data-setting-label="settingLogCategoryNetwork" class="text-base-content/80 text-xs group-hover:text-base-content">Network</span>
                            <div class="tooltip" data-setting-tip="settingLogCategoryNetwork" data-tip="Keep DEBUG and INFO entries of this area. WARN and above ignore this filter.">
                                <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                            </div>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingLogCategoryMap" class="checkbox checkbox-primary checkbox-xs">
                            <span data-setting-label="settingLogCategoryMap" class="text-base-content/80 text-xs group-hover:text-base-content">Map</span>
                            <div class="tooltip" data-setting-tip="settingLogCategoryMap" data-tip="Keep DEBUG and INFO entries of this area. WARN and above ignore this filter.">
                                <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                            </div>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingLogCategoryPlayers" class="checkbox checkbox-primary checkbox-xs">
                            <span data-setting-label="settingLogCategoryPlayers" class="text-base-content/80 text-xs group-hover:text-base-content">Players</span>
                            <div class="tooltip" data-setting-tip="settingLogCategoryPlayers" data-tip="Keep DEBUG and INFO entries of this area. WARN and above ignore this filter.">
                                <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                            </div>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingLogCategoryMobs" class="checkbox checkbox-primary checkbox-xs">
                            <span data-setting-label="settingLogCategoryMobs" class="text-base-content/80 text-xs group-hover:text-base-content">Mobs</span>
                            <div class="tooltip" data-setting-tip="settingLogCategoryMobs" data-tip="Keep DEBUG and INFO entries of this area. WARN and above ignore this filter.">
                                <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                            </div>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingLogCategoryResources" class="checkbox checkbox-primary checkbox-xs">
                            <span data-setting-label="settingLogCategoryResources" class="text-base-content/80 text-xs group-hover:text-base-content">Harvestables</span>
                            <div class="tooltip" data-setting-tip="settingLogCategoryResources" data-tip="Keep DEBUG and INFO entries of this area. WARN and above ignore this filter.">
                                <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                            </div>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingLogCategoryDungeons" class="checkbox checkbox-primary checkbox-xs">
                            <span data-setting-label="settingLogCategoryDungeons" class="text-base-content/80 text-xs group-hover:text-base-content">Dungeons</span>
                            <div class="tooltip" data-setting-tip="settingLogCategoryDungeons" data-tip="Keep DEBUG and INFO entries of this area. WARN and above ignore this filter.">
                                <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                            </div>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingLogCategoryFishing" class="checkbox checkbox-primary checkbox-xs">
                            <span data-setting-label="settingLogCategoryFishing" class="text-base-content/80 text-xs group-hover:text-base-content">Fishing</span>
                            <div class="tooltip" data-setting-tip="settingLogCategoryFishing" data-tip="Keep DEBUG and INFO entries of this area. WARN and above ignore this filter.">
                                <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                            </div>
                        </label>
                </div>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiSettingsDebugOpen"/>
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="bug" class="w-5 h-5 text-warning"></i>
            <span data-setting-label="settingUiSettingsDebugOpen">Debug</span>
            <span class="text-xs text-base-content/50 ml-auto mr-6">Advanced</span>
        </div>
        <div class="collapse-content space-y-4">
            <section>
                <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                    <i data-lucide="swords" class="w-4 h-4"></i>
                    Enemies
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                        <input type="checkbox" data-setting="settingDebugEnemiesUnidentified" class="toggle toggle-primary toggle-sm">
                        <span data-setting-label="settingDebugEnemiesUnidentified" class="text-base-content/80 text-xs group-hover:text-base-content">Show unidentified enemies</span>
                        <div class="tooltip" data-setting-tip="settingDebugEnemiesUnidentified" data-tip="Shows enemies whose type is missing from the bundled mob data, usually new mobs after a game update. The Normal to Boss filters do not apply to them.">
                            <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                        </div>
                    </label>
                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                        <input type="checkbox" data-setting="settingDebugEnemiesTypeId" class="toggle toggle-primary toggle-sm">
                        <span data-setting-label="settingDebugEnemiesTypeId" class="text-base-content/80 text-xs group-hover:text-base-content">Show ID</span>
                    </label>
                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                        <input type="checkbox" data-setting="settingDebugEnemiesTier" class="toggle toggle-primary toggle-sm">
                        <span data-setting-label="settingDebugEnemiesTier" class="text-base-content/80 text-xs group-hover:text-base-content">Show Tier</span>
                    </label>
                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                        <input type="checkbox" data-setting="settingDebugEnemiesName" class="toggle toggle-primary toggle-sm">
                        <span data-setting-label="settingDebugEnemiesName" class="text-base-content/80 text-xs group-hover:text-base-content">Show Name</span>
                    </label>
                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                        <input type="checkbox" data-setting="settingDebugEnemiesCategoryBadge" class="toggle toggle-primary toggle-sm">
                        <span data-setting-label="settingDebugEnemiesCategoryBadge" class="text-base-content/80 text-xs group-hover:text-base-content">Show Category Badge</span>
                    </label>
                </div>
            </section>
            <section>
                <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                    <i data-lucide="leaf" class="w-4 h-4"></i>
                    Resources
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                        <input type="checkbox" data-setting="settingDebugResourcesTypeId" class="toggle toggle-primary toggle-sm">
                        <span data-setting-label="settingDebugResourcesTypeId" class="text-base-content/80 text-xs group-hover:text-base-content">Show ID</span>
                        <div class="tooltip" data-setting-tip="settingDebugResourcesTypeId" data-tip="Draws the internal type ID on resource nodes and living resources (debug).">
                            <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                        </div>
                    </label>
                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                        <input type="checkbox" data-setting="settingDebugResourcesDbName" class="toggle toggle-primary toggle-sm">
                        <span data-setting-label="settingDebugResourcesDbName" class="text-base-content/80 text-xs group-hover:text-base-content">Show DB Name</span>
                        <div class="tooltip" data-setting-tip="settingDebugResourcesDbName" data-tip="Display the DB uniqueName mapped from the wire typeId (debug, for offset/mapping verification).">
                            <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                        </div>
                    </label>
                </div>
            </section>
            <section>
                <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                    <i data-lucide="cloud-fog" class="w-4 h-4"></i>
                    Mists
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                        <input type="checkbox" data-setting="settingDebugMistsWispIds" class="toggle toggle-primary toggle-sm">
                        <span data-setting-label="settingDebugMistsWispIds" class="text-base-content/80 text-xs group-hover:text-base-content">Show wisp ID (debug)</span>
                    </label>
                </div>
            </section>
            <section>
                <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                    <i data-lucide="zap" class="w-4 h-4"></i>
                    Network traffic
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                        <input type="checkbox" data-setting="settingDebugWsCoalescing" class="toggle toggle-primary toggle-sm">
                        <span data-setting-label="settingDebugWsCoalescing" class="text-base-content/80 text-xs group-hover:text-base-content">Merge entity updates per frame</span>
                        <div class="tooltip" data-setting-tip="settingDebugWsCoalescing" data-tip="Keeps only the latest move, health and regeneration update per entity until the next frame is drawn.">
                            <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                        </div>
                    </label>
                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                        <input type="checkbox" id="settingDebugPcapRecording" data-setting="settingDebugPcapRecording" class="toggle toggle-primary toggle-sm"{{if not .IsHost}} disabled{{end}}>
                        <i data-lucide="circle-dot" class="w-4 h-4 text-base-content/50"></i>
                        <span data-setting-label="settingDebugPcapRecording" class="text-base-content/80 text-xs group-hover:text-base-content">Record Network Capture (pcap)</span>
                        <div class="tooltip" data-setting-tip="settingDebugPcapRecording" data-tip="Records Albion game traffic (UDP 5056) to logs/captures/, one .pcap per capture interface. Only changeable from the PC running the radar.">
                            <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                        </div>
                        {{if not .IsHost}}<span class="text-xs text-base-content/50">Only the PC running the radar can change this.</span>{{end}}
                    </label>
                </div>
            </section>
            <section>
                <h3 class="text-sm font-semibold text-base-content/80 mb-3 flex items-center gap-2">
                    <i data-lucide="hard-drive" class="w-4 h-4"></i>
                    Backend logs
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                        <input type="checkbox" id="settingDebugBackendLogs" data-setting="settingDebugBackendLogs" class="toggle toggle-primary toggle-sm"{{if not .IsHost}} disabled{{end}}>
                        <i data-lucide="hard-drive" class="w-4 h-4 text-base-content/50"></i>
                        <span data-setting-label="settingDebugBackendLogs" class="text-base-content/80 text-xs group-hover:text-base-content">Save backend logs</span>
                        <div class="tooltip" data-setting-tip="settingDebugBackendLogs" data-tip="Writes one line per decoded game event to logs/sessions/. Only changeable from the PC running the radar.">
                            <i data-lucide="info" class="w-3 h-3 opacity-50"></i>
                        </div>
                        {{if not .IsHost}}<span class="text-xs text-base-content/50">Only the PC running the radar can change this.</span>{{end}}
                    </label>
                </div>
            </section>
            <div class="flex flex-wrap items-center gap-4">
                <button id="downloadLogsBtn" class="btn btn-primary btn-sm">
                    <i data-lucide="download" class="w-4 h-4"></i>
                    Export Debug Data
                </button>
                <span class="flex-1 basis-40 max-w-max text-xs text-base-content/50">Downloads registry settings, UI state and backend logging values as JSON. The ignore list is not included.</span>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiSettingsNetworkOpen"/>
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="wifi" class="w-5 h-5 text-primary"></i>
            <span data-setting-label="settingUiSettingsNetworkOpen">Network</span>
        </div>
        <div class="collapse-content">
            <div id="network-section" class="text-base-content/80"{{if not .IsHost}} data-locked{{end}}>Loading network configuration…</div>
        </div>
    </div>

    <div class="card bg-error/5 border border-error/20">
        <div class="card-body">
            <h2 class="text-lg font-semibold text-error mb-3 flex items-center gap-2">
                <i data-lucide="alert-octagon" class="w-5 h-5"></i>
                Danger Zone
            </h2>
            <div class="flex flex-wrap gap-3">
                <button id="resetSettingsBtn" class="btn btn-outline btn-error btn-sm">
                    <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                    Reset All Settings
                </button>
            </div>
        </div>
    </div>
</div>
{{end}}

{{define "scripts/settings"}}
<script>
    import('/scripts/utils/SettingControls.js').then(({registerBoundPage, resetAllSettings, buildDebugExport}) => registerBoundPage('settings', {
        async init({root, signal}) {
            const settingsSync = window.settingsSync;
            const byId = id => document.getElementById(id);

            byId('downloadLogsBtn')?.addEventListener('click', async () => {
                const timestamp = new Date().toISOString().replace(/[:.]/g, '-');
                const debugData = await buildDebugExport(settingsSync, fetch);

                const blob = new Blob([JSON.stringify(debugData, null, 2)], {type: 'application/json'});
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `openradar-debug-${timestamp}.json`;
                a.click();
                URL.revokeObjectURL(url);
            }, {signal});

            byId('resetSettingsBtn')?.addEventListener('click', () => {
                byId('modal-resetSettings').showModal();
            }, {signal});

            byId('confirmResetSettings')?.addEventListener('click', () => {
                resetAllSettings(settingsSync);
                byId('modal-resetSettings').close();
                if (window.toast) window.toast.success('Settings reset successfully');
                setTimeout(() => location.reload(), 500);
            }, {signal});

            const {BackendLoggingToggles} = await import('/scripts/utils/BackendLoggingToggles.js');
            if (signal.aborted) return;
            const hostContainer = root.querySelector('[data-is-host]');
            if (hostContainer) {
                const backendToggles = new BackendLoggingToggles(hostContainer);
                signal.addEventListener('abort', () => backendToggles.destroy(), {once: true});
                await backendToggles.load();
                if (signal.aborted) return;
            }

            const {NetworkSettingsHandler} = await import('/scripts/handlers/NetworkSettingsHandler.js');
            const networkContainer = byId('network-section');
            if (!networkContainer || signal.aborted) return;
            const networkHandler = new NetworkSettingsHandler(networkContainer);
            networkHandler.load();
            const networkPoll = setInterval(() => {
                if (!document.hidden) networkHandler.load();
            }, 5000);
            signal.addEventListener('abort', () => clearInterval(networkPoll), {once: true});
        },
    }));
</script>
{{end}}
