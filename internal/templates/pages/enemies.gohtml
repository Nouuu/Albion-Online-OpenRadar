{{define "pages/enemies"}}
<div class="space-y-6 stagger">
    <div class="card bg-base-200">
        <div class="card-body">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div>
                    <h1 class="text-3xl font-bold text-base-content">Enemies</h1>
                    <p class="text-base-content/60 mt-2">Configure enemy and mob detection settings.</p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <button type="button" data-enemy-preset="all" class="btn btn-primary btn-xs">All</button>
                    <button type="button" data-enemy-preset="clear" class="btn btn-error btn-xs">Clear</button>
                </div>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiEnemiesClassicOpen" aria-labelledby="label-settingUiEnemiesClassicOpen"/>
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="swords" class="w-5 h-5"></i>
            <span id="label-settingUiEnemiesClassicOpen" data-setting-label="settingUiEnemiesClassicOpen">Classic Enemies</span>
        </div>
        <div class="collapse-content">
            <div class="pt-2">
                <div class="grid grid-cols-[repeat(auto-fill,minmax(min(16rem,100%),1fr))] gap-2">
                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                        <input type="checkbox" data-setting="settingEnemiesNormal" aria-labelledby="label-settingEnemiesNormal" class="checkbox checkbox-info checkbox-xs">
                        <span class="w-3 h-3 rounded-full bg-tier-3"></span>
                        <span id="label-settingEnemiesNormal" data-setting-label="settingEnemiesNormal" class="text-base-content/80 text-xs group-hover:text-base-content">Normal</span>
                        <div class="tooltip" data-setting-tip="settingEnemiesNormal" data-tip="Show basic enemies (low threat, easiest to kill).">
                            <span tabindex="0" role="img" aria-label="Show basic enemies (low threat, easiest to kill)." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                        </div>
                    </label>

                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                        <input type="checkbox" data-setting="settingEnemiesChampion" aria-labelledby="label-settingEnemiesChampion" class="checkbox checkbox-secondary checkbox-xs">
                        <span class="w-3 h-3 rounded-full bg-tier-4"></span>
                        <span id="label-settingEnemiesChampion" data-setting-label="settingEnemiesChampion" class="text-base-content/80 text-xs group-hover:text-base-content">Champion</span>
                        <div class="tooltip" data-setting-tip="settingEnemiesChampion" data-tip="Champion mobs, and solo mobs in random dungeons.">
                            <span tabindex="0" role="img" aria-label="Champion mobs, and solo mobs in random dungeons." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                        </div>
                    </label>

                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                        <input type="checkbox" data-setting="settingEnemiesMiniBoss" aria-labelledby="label-settingEnemiesMiniBoss" class="checkbox checkbox-warning checkbox-xs">
                        <span class="w-3 h-3 rounded-full bg-tier-5"></span>
                        <span id="label-settingEnemiesMiniBoss" data-setting-label="settingEnemiesMiniBoss" class="text-base-content/80 text-xs group-hover:text-base-content">Mini-Boss</span>
                        <div class="tooltip" data-setting-tip="settingEnemiesMiniBoss" data-tip="Show mini-bosses (strong enemies, valuable loot).">
                            <span tabindex="0" role="img" aria-label="Show mini-bosses (strong enemies, valuable loot)." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                        </div>
                    </label>

                    <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                        <input type="checkbox" data-setting="settingEnemiesBoss" aria-labelledby="label-settingEnemiesBoss" class="checkbox checkbox-error checkbox-xs">
                        <span class="w-3 h-3 rounded-full bg-tier-7"></span>
                        <span id="label-settingEnemiesBoss" data-setting-label="settingEnemiesBoss" class="text-base-content/80 text-xs group-hover:text-base-content">Boss</span>
                        <div class="tooltip" data-setting-tip="settingEnemiesBoss" data-tip="Show boss enemies (very high threat, best loot).">
                            <span tabindex="0" role="img" aria-label="Show boss enemies (very high threat, best loot)." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                        </div>
                    </label>
                </div>

                <div class="border-t border-base-content/10 mt-4 pt-4">
                    <div class="grid grid-cols-[repeat(auto-fill,minmax(min(16rem,100%),1fr))] gap-2">
                        <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                            <input type="checkbox" data-setting="settingEnemiesMinHealthFilter" aria-labelledby="label-settingEnemiesMinHealthFilter" class="toggle toggle-primary toggle-sm">
                            <span id="label-settingEnemiesMinHealthFilter" data-setting-label="settingEnemiesMinHealthFilter" class="text-base-content/80 text-xs group-hover:text-base-content">Show enemies with minimum HP</span>
                            <div class="tooltip" data-setting-tip="settingEnemiesMinHealthFilter" data-tip="Hides Normal to Boss enemies and unidentified enemies whose maximum HP is below the threshold. Drones, Mists bosses, event enemies and living resources are not filtered.">
                                <span tabindex="0" role="img" aria-label="Hides Normal to Boss enemies and unidentified enemies whose maximum HP is below the threshold. Drones, Mists bosses, event enemies and living resources are not filtered." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                            </div>
                        </label>

                        <div class="col-span-full ml-8">
                            <label class="flex flex-wrap items-center gap-3">
                                <input type="number" data-setting="settingEnemiesMinHealth" data-enabled-by="settingEnemiesMinHealthFilter"
                                       min="100" max="1000000" step="100"
                                       class="input input-bordered input-sm w-32 disabled:opacity-50">
                                <span id="label-settingEnemiesMinHealth" data-setting-label="settingEnemiesMinHealth" class="text-base-content/60 text-sm">Minimum HP</span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiEnemiesMistsOpen" aria-labelledby="label-settingUiEnemiesMistsOpen"/>
        <div class="collapse-title text-xl font-semibold flex flex-wrap items-center gap-2">
            <i data-lucide="cloud-fog" class="w-5 h-5"></i>
            <span id="label-settingUiEnemiesMistsOpen" data-setting-label="settingUiEnemiesMistsOpen">Mists Bosses</span>
            <span class="badge bg-warning/20 border-warning/40 text-warning gap-1"><i data-lucide="flask-conical" class="w-3 h-3"></i>Experimental</span>
        </div>
        <div class="collapse-content">
            <div class="grid grid-cols-[repeat(auto-fill,minmax(min(16rem,100%),1fr))] gap-2 pt-2">
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingEnemiesMistsCrystalSpider" aria-labelledby="label-settingEnemiesMistsCrystalSpider" class="checkbox checkbox-primary checkbox-xs">
                    <span class="w-3 h-3 rounded-full bg-tier-4"></span>
                    <span id="label-settingEnemiesMistsCrystalSpider" data-setting-label="settingEnemiesMistsCrystalSpider" class="text-base-content/80 text-xs group-hover:text-base-content">Crystal Spider</span>
                    <div class="tooltip" data-setting-tip="settingEnemiesMistsCrystalSpider" data-tip="Show Crystal Spider bosses (Mists exclusive).">
                        <span tabindex="0" role="img" aria-label="Show Crystal Spider bosses (Mists exclusive)." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                    </div>
                </label>

                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingEnemiesMistsFairyDragon" aria-labelledby="label-settingEnemiesMistsFairyDragon" class="checkbox checkbox-primary checkbox-xs">
                    <span class="w-3 h-3 rounded-full bg-tier-4"></span>
                    <span id="label-settingEnemiesMistsFairyDragon" data-setting-label="settingEnemiesMistsFairyDragon" class="text-base-content/80 text-xs group-hover:text-base-content">Fairy Dragon</span>
                    <div class="tooltip" data-setting-tip="settingEnemiesMistsFairyDragon" data-tip="Show Fairy Dragon bosses (Mists exclusive).">
                        <span tabindex="0" role="img" aria-label="Show Fairy Dragon bosses (Mists exclusive)." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                    </div>
                </label>

                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingEnemiesMistsVeilWeaver" aria-labelledby="label-settingEnemiesMistsVeilWeaver" class="checkbox checkbox-primary checkbox-xs">
                    <span class="w-3 h-3 rounded-full bg-tier-4"></span>
                    <span id="label-settingEnemiesMistsVeilWeaver" data-setting-label="settingEnemiesMistsVeilWeaver" class="text-base-content/80 text-xs group-hover:text-base-content">Veil Weaver</span>
                    <div class="tooltip" data-setting-tip="settingEnemiesMistsVeilWeaver" data-tip="Show Veil Weaver bosses (Mists exclusive).">
                        <span tabindex="0" role="img" aria-label="Show Veil Weaver bosses (Mists exclusive)." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                    </div>
                </label>

                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingEnemiesMistsGriffin" aria-labelledby="label-settingEnemiesMistsGriffin" class="checkbox checkbox-primary checkbox-xs">
                    <span class="w-3 h-3 rounded-full bg-tier-4"></span>
                    <span id="label-settingEnemiesMistsGriffin" data-setting-label="settingEnemiesMistsGriffin" class="text-base-content/80 text-xs group-hover:text-base-content">Griffin</span>
                    <div class="tooltip" data-setting-tip="settingEnemiesMistsGriffin" data-tip="Show Griffin bosses (Mists exclusive).">
                        <span tabindex="0" role="img" aria-label="Show Griffin bosses (Mists exclusive)." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                    </div>
                </label>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiEnemiesOtherOpen" aria-labelledby="label-settingUiEnemiesOtherOpen"/>
        <div class="collapse-title text-xl font-semibold flex flex-wrap items-center gap-2">
            <i data-lucide="sparkles" class="w-5 h-5"></i>
            <span id="label-settingUiEnemiesOtherOpen" data-setting-label="settingUiEnemiesOtherOpen">Other Enemies</span>
            <span class="badge bg-warning/20 border-warning/40 text-warning gap-1"><i data-lucide="flask-conical" class="w-3 h-3"></i>Not validated yet</span>
        </div>
        <div class="collapse-content">
            <div class="grid grid-cols-[repeat(auto-fill,minmax(min(16rem,100%),1fr))] gap-2 pt-2">
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingEnemiesAvalonianDrones" aria-labelledby="label-settingEnemiesAvalonianDrones" class="checkbox checkbox-primary checkbox-xs">
                    <span id="label-settingEnemiesAvalonianDrones" data-setting-label="settingEnemiesAvalonianDrones" class="text-base-content/80 text-xs group-hover:text-base-content">Avalonian Drones</span>
                    <div class="tooltip" data-setting-tip="settingEnemiesAvalonianDrones" data-tip="Not detected yet: no mob is classified as this type today.">
                        <span tabindex="0" role="img" aria-label="Not detected yet: no mob is classified as this type today." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                    </div>
                </label>

                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingEnemiesEvent" aria-labelledby="label-settingEnemiesEvent" class="checkbox checkbox-primary checkbox-xs">
                    <span id="label-settingEnemiesEvent" data-setting-label="settingEnemiesEvent" class="text-base-content/80 text-xs group-hover:text-base-content">Event Enemies</span>
                    <div class="tooltip" data-setting-tip="settingEnemiesEvent" data-tip="Not detected yet: no mob is classified as this type today.">
                        <span tabindex="0" role="img" aria-label="Not detected yet: no mob is classified as this type today." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                    </div>
                </label>
            </div>
        </div>
    </div>

    <div class="card bg-base-200">
        <div class="card-body">
            <h2 class="text-xl font-semibold text-base-content mb-4 flex items-center gap-2">
                <i data-lucide="eye" class="w-5 h-5 text-primary"></i>
                Display
            </h2>
            <div class="grid grid-cols-[repeat(auto-fill,minmax(min(16rem,100%),1fr))] gap-2">
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingEnemiesShowHealthBars" class="toggle toggle-primary toggle-sm">
                    <span id="label-settingEnemiesShowHealthBars" data-setting-label="settingEnemiesShowHealthBars" class="text-base-content/80 text-xs group-hover:text-base-content">Show health bars</span>
                </label>
            </div>
        </div>
    </div>
</div>
{{end}}

{{define "scripts/enemies"}}
<script>
    import('/scripts/utils/SettingControls.js').then(({registerBoundPage}) => registerBoundPage('enemies'));
</script>
{{end}}
