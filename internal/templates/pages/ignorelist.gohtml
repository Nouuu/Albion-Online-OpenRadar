{{define "pages/ignorelist"}}
<div class="space-y-6 stagger" data-setting="settingIgnoreList">
    <div class="card bg-base-200">
        <div class="card-body">
            <h1 class="text-3xl font-bold text-base-content">Ignore List</h1>
            <p class="text-base-content/60 mt-2">Names on this list never trigger the alert sound, the screen flash or the red border. Ignored players still appear in the player list.</p>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiIgnoreListAddNameOpen" aria-labelledby="label-settingUiIgnoreListAddNameOpen"/>
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <span id="label-settingUiIgnoreListAddNameOpen" data-setting-label="settingUiIgnoreListAddNameOpen">Add name</span>
        </div>
        <div class="collapse-content">
            <div class="flex gap-3">
                <input type="text" data-ignore-input placeholder="Player, guild or alliance name"
                       class="input input-bordered flex-1">
                <button type="button" data-ignore-add class="btn btn-primary">Add name</button>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiIgnoreListIgnoredNamesOpen" aria-labelledby="label-settingUiIgnoreListIgnoredNamesOpen"/>
        <div class="collapse-title text-xl font-semibold flex flex-wrap items-center gap-2">
            <span id="label-settingUiIgnoreListIgnoredNamesOpen" data-setting-label="settingUiIgnoreListIgnoredNamesOpen">Ignored names</span>
            <span data-ignore-count class="badge badge-ghost font-mono"></span>
            <span class="hidden" data-setting-label="settingIgnoreList">Ignored names</span>
        </div>
        <div class="collapse-content">
            <div class="space-y-2">
                <p data-ignore-empty class="text-base-content/50 text-center py-8 italic">The ignore list is empty</p>
                <div data-ignore-items class="space-y-2"></div>
            </div>
        </div>
    </div>
</div>
{{end}}

{{define "scripts/ignorelist"}}
<script>
    import('/scripts/utils/SettingControls.js').then(({registerBoundPage}) => registerBoundPage('ignorelist'));
</script>
{{end}}
