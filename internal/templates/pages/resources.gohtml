{{define "pages/resources"}}
<div class="space-y-6 stagger">
    <div class="card bg-base-200">
        <div class="card-body">
            <div>
                <h1 class="text-3xl font-bold text-base-content">Resources</h1>
                <p class="text-base-content/60 mt-2">Configure which resources to display on the radar.</p>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiResourcesFiberOpen" aria-labelledby="label-settingUiResourcesFiberOpen"/>
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="flower-2" class="w-5 h-5 text-green-400"></i>
            <span id="label-settingUiResourcesFiberOpen" data-setting-label="settingUiResourcesFiberOpen">Fiber</span>
        </div>
        <div class="collapse-content">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div data-setting="settingResourcesStaticFiber"></div>
                <div data-setting="settingResourcesLivingFiber"></div>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiResourcesHideOpen" aria-labelledby="label-settingUiResourcesHideOpen"/>
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="rabbit" class="w-5 h-5 text-amber-400"></i>
            <span id="label-settingUiResourcesHideOpen" data-setting-label="settingUiResourcesHideOpen">Hide</span>
        </div>
        <div class="collapse-content">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div data-setting="settingResourcesStaticHide"></div>
                <div data-setting="settingResourcesLivingHide"></div>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiResourcesWoodOpen" aria-labelledby="label-settingUiResourcesWoodOpen"/>
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="tree-pine" class="w-5 h-5 text-emerald-400"></i>
            <span id="label-settingUiResourcesWoodOpen" data-setting-label="settingUiResourcesWoodOpen">Wood</span>
        </div>
        <div class="collapse-content">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div data-setting="settingResourcesStaticWood"></div>
                <div data-setting="settingResourcesLivingWood"></div>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiResourcesOreOpen" aria-labelledby="label-settingUiResourcesOreOpen"/>
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="gem" class="w-5 h-5 text-blue-400"></i>
            <span id="label-settingUiResourcesOreOpen" data-setting-label="settingUiResourcesOreOpen">Ore</span>
        </div>
        <div class="collapse-content">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div data-setting="settingResourcesStaticOre"></div>
                <div data-setting="settingResourcesLivingOre"></div>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiResourcesRockOpen" aria-labelledby="label-settingUiResourcesRockOpen"/>
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="mountain" class="w-5 h-5 text-gray-400"></i>
            <span id="label-settingUiResourcesRockOpen" data-setting-label="settingUiResourcesRockOpen">Rock</span>
        </div>
        <div class="collapse-content">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div data-setting="settingResourcesStaticRock"></div>
                <div data-setting="settingResourcesLivingRock"></div>
            </div>
        </div>
    </div>

    <div class="card bg-base-200">
        <div class="card-body">
            <h2 class="text-xl font-semibold text-base-content mb-4 flex items-center gap-2">
                <i data-lucide="fish" class="w-5 h-5 text-primary"></i>
                Other
            </h2>
            <div class="grid grid-cols-1 gap-2 max-w-xl">
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingResourcesFishing" aria-labelledby="label-settingResourcesFishing" class="toggle toggle-primary toggle-sm">
                    <span id="label-settingResourcesFishing" data-setting-label="settingResourcesFishing" class="text-base-content/80 text-xs group-hover:text-base-content">Show Fishing Pools</span>
                </label>
            </div>
        </div>
    </div>

    <div class="card bg-base-200">
        <div class="card-body">
            <h2 class="text-xl font-semibold text-base-content mb-4 flex items-center gap-2">
                <i data-lucide="eye" class="w-5 h-5 text-primary"></i>
                Display
            </h2>
            <div class="grid grid-cols-1 gap-2 max-w-xl">
                <label class="flex items-center gap-2 p-2 rounded-lg bg-base-300 cursor-pointer group hover:bg-base-300/70 transition-colors">
                    <input type="checkbox" data-setting="settingResourcesShowHealthBars" aria-labelledby="label-settingResourcesShowHealthBars" class="toggle toggle-primary toggle-sm">
                    <span id="label-settingResourcesShowHealthBars" data-setting-label="settingResourcesShowHealthBars" class="text-base-content/80 text-xs group-hover:text-base-content">Show health bars</span>
                    <div class="tooltip" data-setting-tip="settingResourcesShowHealthBars" data-tip="Display health bar on living resources (mobs).">
                        <span tabindex="0" role="img" aria-label="Display health bar on living resources (mobs)." class="block"><i data-lucide="info" class="w-3 h-3 opacity-50"></i></span>
                    </div>
                </label>
            </div>
        </div>
    </div>
</div>
{{end}}

{{define "scripts/resources"}}
<script>
    import('/scripts/utils/SettingControls.js').then(({registerBoundPage}) => registerBoundPage('resources'));
</script>
{{end}}
