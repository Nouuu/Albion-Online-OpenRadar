{{define "pages/resources"}}
<div class="space-y-6 stagger">
    <div class="card bg-base-200">
        <div class="card-body">
            <div>
                <h1 class="text-3xl font-bold text-base-content">Resources</h1>
                <p class="text-base-content/60 mt-2">Configure which resources to display on the radar.</p>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiResourcesFiberOpen" />
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="flower-2" class="w-5 h-5 text-green-400"></i>
            <span data-setting-label="settingUiResourcesFiberOpen">Fiber</span>
        </div>
        <div class="collapse-content">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div data-setting="settingResourcesStaticFiber"></div>
                <div data-setting="settingResourcesLivingFiber"></div>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiResourcesHideOpen" />
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="rabbit" class="w-5 h-5 text-amber-400"></i>
            <span data-setting-label="settingUiResourcesHideOpen">Hide</span>
        </div>
        <div class="collapse-content">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div data-setting="settingResourcesStaticHide"></div>
                <div data-setting="settingResourcesLivingHide"></div>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiResourcesWoodOpen" />
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="tree-pine" class="w-5 h-5 text-emerald-400"></i>
            <span data-setting-label="settingUiResourcesWoodOpen">Wood</span>
        </div>
        <div class="collapse-content">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div data-setting="settingResourcesStaticWood"></div>
                <div data-setting="settingResourcesLivingWood"></div>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiResourcesOreOpen" />
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="gem" class="w-5 h-5 text-blue-400"></i>
            <span data-setting-label="settingUiResourcesOreOpen">Ore</span>
        </div>
        <div class="collapse-content">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div data-setting="settingResourcesStaticOre"></div>
                <div data-setting="settingResourcesLivingOre"></div>
            </div>
        </div>
    </div>

    <div class="collapse collapse-arrow bg-base-200 rounded-xl">
        <input type="checkbox" data-setting="settingUiResourcesRockOpen" />
        <div class="collapse-title text-xl font-semibold flex items-center gap-2">
            <i data-lucide="mountain" class="w-5 h-5 text-gray-400"></i>
            <span data-setting-label="settingUiResourcesRockOpen">Rock</span>
        </div>
        <div class="collapse-content">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div data-setting="settingResourcesStaticRock"></div>
                <div data-setting="settingResourcesLivingRock"></div>
            </div>
        </div>
    </div>

    <div class="card bg-base-200">
        <div class="card-body">
            <h2 class="text-xl font-semibold text-base-content mb-4 flex items-center gap-2">
                <i data-lucide="fish" class="w-5 h-5 text-primary"></i>
                Other
            </h2>
            <label class="flex items-center gap-3 cursor-pointer group">
                <input type="checkbox" data-setting="settingResourcesFishing" class="checkbox checkbox-primary">
                <span data-setting-label="settingResourcesFishing" class="text-base-content/80 group-hover:text-base-content transition-colors">Show Fishing Pools</span>
                <div class="tooltip" data-setting-tip="settingResourcesFishing" data-tip="Shows fishing spots on the radar.">
                    <i data-lucide="info" class="w-4 h-4 opacity-50"></i>
                </div>
            </label>
        </div>
    </div>

    <div class="card bg-base-200">
        <div class="card-body">
            <h2 class="text-xl font-semibold text-base-content mb-4 flex items-center gap-2">
                <i data-lucide="eye" class="w-5 h-5 text-primary"></i>
                Display
            </h2>
            <label class="flex items-center gap-3 cursor-pointer group">
                <input type="checkbox" data-setting="settingResourcesShowHealthBars" class="checkbox checkbox-primary">
                <span data-setting-label="settingResourcesShowHealthBars" class="text-base-content/80 group-hover:text-base-content transition-colors">Show health bars</span>
                <div class="tooltip" data-setting-tip="settingResourcesShowHealthBars" data-tip="Display health bar on living resources (mobs).">
                    <i data-lucide="info" class="w-4 h-4 opacity-50"></i>
                </div>
            </label>
        </div>
    </div>
</div>
{{end}}

{{define "scripts/resources"}}
<script>
    import('/scripts/utils/SettingControls.js').then(({registerBoundPage}) => registerBoundPage('resources'));
</script>
{{end}}
